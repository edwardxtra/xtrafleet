rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isParticipant(participants) {
      return request.auth.uid in participants;
    }

    // DEV-199: read the admin fields defensively.
    //
    // Most owner_operators documents have no `isAdmin` field at all — it is
    // absent, not false. Reading a missing property in rules is an ERROR,
    // not false, so the direct `.data.isAdmin` form threw for those users
    // instead of returning false.
    //
    // That was never a security hole: an evaluation error denies the
    // request, so the outcome was "denied" either way, and legitimate paths
    // were unaffected because short-circuit evaluation means a normal
    // self-edit satisfies `isOwner(...) && selfUpdateIsClean()` and never
    // reaches isSuperAdmin(). What it cost was diagnosability — denials
    // surfaced in the Rules Playground as a red error
    // ("Property isAdmin is undefined on object") rather than a clean
    // DENIED, and the helpers behaved differently depending on whether a
    // document happened to carry the field.
    //
    // `.data.get(field, default)` is the same accessor this file already
    // uses for `accountStatus` below.
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/owner_operators/$(request.auth.uid))
          .data.get('isAdmin', false) == true;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/owner_operators/$(request.auth.uid))
          .data.get('isAdmin', false) == true &&
        get(/databases/$(database)/documents/owner_operators/$(request.auth.uid))
          .data.get('adminRole', '') == 'super_admin';
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    // SECURITY FIX: Restrict driver invitation access
    match /driver_invitations/{invitationId} {
      // Allow reading specific invitation (for validation)
      allow get: if true; // Token-based validation, checked server-side
      // Only allow owner to list their own invitations
      allow list: if isSignedIn() &&
                     request.query.where[0][0] == 'ownerId' &&
                     request.query.where[0][2] == request.auth.uid;
      // Only owner can create invitations
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerId;
      // Only owner or super_admin can update/delete their invitations
      allow update, delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
    }

    match /owner_operators/{ownerOperatorId} {
      // Pre-activated accounts (white-glove onboarding, DEV-158) are readable
      // only by their owner or an admin — never by other users.
      allow get: if isSignedIn() && (
        resource.data.get('accountStatus', 'active') != 'pre-activated' ||
        isOwner(ownerOperatorId) ||
        isAdmin()
      );
      allow list: if isSignedIn();

      // SECURITY FIX (privilege escalation): the account holder may write
      // their own profile, but NOT the fields that decide privilege, account
      // lifecycle or billing state. isAdmin()/isSuperAdmin() above read
      // `isAdmin`/`adminRole` off THIS document, so an unrestricted self-write
      // was a one-step path from any signed-in owner-operator to super_admin
      // — and from there to the admin console and the impersonation endpoint.
      // These fields are written server-side (the Admin SDK bypasses rules) or
      // by a super_admin via /admin/settings, never by the holder themselves.
      function protectedOwnerFields() {
        return [
          'isAdmin', 'adminRole', 'adminRoleUpdatedAt', 'adminRoleUpdatedBy',
          'adminRevokedAt', 'adminRevokedBy',
          'accountStatus', 'activatedAt', 'createdByAdmin',
          'isSuspended', 'suspendedAt', 'suspendedBy', 'suspendedReason',
          'reactivatedAt', 'reactivatedBy',
          'subscriptionStatus', 'subscriptionPlan'
        ];
      }

      // Same list minus subscriptionStatus, which a self-create may seed —
      // see selfCreateIsClean().
      function protectedOnCreateFields() {
        return [
          'isAdmin', 'adminRole', 'adminRoleUpdatedAt', 'adminRoleUpdatedBy',
          'adminRevokedAt', 'adminRevokedBy',
          'accountStatus', 'activatedAt', 'createdByAdmin',
          'isSuspended', 'suspendedAt', 'suspendedBy', 'suspendedReason',
          'reactivatedAt', 'reactivatedBy',
          'subscriptionPlan'
        ];
      }

      function selfUpdateIsClean() {
        return !request.resource.data.diff(resource.data)
                 .affectedKeys().hasAny(protectedOwnerFields());
      }

      // The incomplete-registration repair path in /login creates the holder's
      // own doc with subscriptionStatus:'inactive'. That exact seed stays
      // allowed; any other privileged value does not.
      function selfCreateIsClean() {
        return !request.resource.data.keys().hasAny(protectedOnCreateFields())
               && (!('subscriptionStatus' in request.resource.data)
                   || request.resource.data.subscriptionStatus == 'inactive');
      }

      allow create: if isSignedIn() && isOwner(ownerOperatorId) && selfCreateIsClean();
      allow update: if isSignedIn() && (
        (isOwner(ownerOperatorId) && selfUpdateIsClean()) ||
        isSuperAdmin()
      );
      allow delete: if isSignedIn() && (isOwner(ownerOperatorId) || isSuperAdmin());

      match /drivers/{driverId} {
        // Pre-activated drivers (DEV-158) are readable only by their owner,
        // the driver themselves, or an admin.
        //
        // `request.auth.uid == driverId` is NOT redundant, and leaving it out
        // is a live onboarding break rather than a theoretical one. A driver
        // document's id IS the driver's auth uid (the same assumption the
        // update rule below already makes), and a pre-activated driver reads
        // their own document on /driver-dashboard/complete-profile — the page
        // whose whole job is to stop being pre-activated. They are not
        // isOwner (that is their carrier) and not isAdmin, so without this
        // branch the first condition is false for them and they cannot load
        // the page.
        //
        // This guard was inert until now: the collection-group rule below
        // also matched this path with a blanket `if isSignedIn()`, and
        // Firestore grants access when ANY matching rule allows it. Closing
        // that rule is what makes these three branches start mattering, which
        // is why the missing one surfaces as part of the same change.
        allow get: if isSignedIn() && (
          resource.data.get('accountStatus', 'active') != 'pre-activated' ||
          isOwner(ownerOperatorId) ||
          request.auth.uid == driverId ||
          isAdmin()
        );
        // Enumeration is owner-or-admin. Every dashboard surface lists only
        // `owner_operators/{own uid}/drivers`; the one caller that lists
        // somebody else's roster is /admin/users.
        allow list: if isSignedIn() && (isOwner(ownerOperatorId) || isAdmin());
        allow create: if isSignedIn() && isOwner(ownerOperatorId);
        allow update: if isSignedIn() && (isOwner(ownerOperatorId) || request.auth.uid == driverId || isAdmin());
        allow delete: if isSignedIn() && (isOwner(ownerOperatorId) || isSuperAdmin());
      }

      match /loads/{loadId} {
        // `get` stays open to any signed-in user. A single load is fetched by
        // the OTHER party to a match in two places — tla-actions.ts reads the
        // load behind a TLA, messaging-utils.ts reads it to label a thread —
        // and neither caller is the load's owner. Narrowing this would need a
        // get() into /matches per read to prove the caller is a party, which
        // is a lookup per access to protect a document you must already know
        // both ids to request.
        allow get: if isSignedIn();
        // `list` is the enumeration, and that one is owner-or-admin. Nothing
        // outside the admin console lists another carrier's loads: the
        // dashboard lists only its own, and the marketplace board now goes
        // through /api/marketplace/loads, which projects.
        //
        // Note this REPLACES `allow read`, which covered get and list both —
        // rules are a union, so leaving it alongside would have kept list
        // open to everyone and made the line below decorative.
        allow list: if isSignedIn() && (isOwner(ownerOperatorId) || isAdmin());
        allow create: if isSignedIn() && isOwner(ownerOperatorId);
        // Match formation runs server-side (/api/matches/accept) via the Admin
        // SDK, which bypasses rules. Clients may no longer flip a load to
        // 'Matched' directly — that would skip the compliance gate (DEV-162).
        allow update: if isSignedIn() && (
          isOwner(ownerOperatorId) || // Owner can always update
          isAdmin() // Admins can update
        );
        allow delete: if isSignedIn() && (isOwner(ownerOperatorId) || isSuperAdmin());
      }

      match /subscriptions/{subscriptionId} {
        allow read: if isSignedIn() && (isOwner(ownerOperatorId) || isAdmin());
        allow write: if isSignedIn() && (isOwner(ownerOperatorId) || isSuperAdmin());
      }
    }

    // Collection Group Query for drivers
    // Collection group query for drivers — admin console only.
    //
    // This rule is why the nested pre-activation guard above was inert: it
    // matched the same paths with a blanket `if isSignedIn()`, and access is
    // granted when ANY matching rule allows it. So a stranger could read a
    // pre-activated driver by the very path the nested rule claimed to
    // protect, and could enumerate every driver in the platform besides.
    //
    // A driver document is the whole DQF: CDL number and state, MVR number,
    // medical card expiry, insurance policy number, phone and email, plus
    // storage URLs for the CDL scan, MVR and drug-and-alcohol screening —
    // and those URLs carry Firebase download tokens, so they resolve for
    // anyone holding them regardless of storage.rules.
    //
    // /dashboard/matches used to issue an unfiltered collectionGroup query
    // here; it reads /api/marketplace/drivers now (#271–#276), which projects
    // about a dozen fields of forty. The remaining client callers are all
    // admin: /admin/page.tsx, /admin/drivers/page.tsx, and
    // admin-create-match-modal (imported only by /admin/matches).
    // src/ai/tools/owner-tools.ts uses the Admin SDK and bypasses rules.
    //
    // No backfill is required first. The old note here said closing this
    // needed one, because legacy drivers carry no accountStatus field and a
    // Firestore query cannot match a missing field. That constraint applied
    // to filtering in a QUERY; the projection filters in application code
    // instead — projection.ts reads `(raw.accountStatus ?? 'active')`, the
    // same default this file's guard uses via .data.get(). The two agree, so
    // a legacy driver is treated as active in both places.
    match /{path=**}/drivers/{driverId} {
      allow read: if isSignedIn() && isAdmin();
    }

    // Collection group query for loads — admin console only.
    //
    // A collection group query matches ONLY this rule, never the nested
    // /owner_operators/{id}/loads one, so this is the rule that decided
    // whether any signed-in user could enumerate every load in the platform.
    // It could, and /dashboard/matches did exactly that: an unfiltered
    // collectionGroup('loads') subscription streaming every load document to
    // every browser, status-filtered locally. That board reads
    // /api/marketplace/loads now, which filters in Firestore and withholds
    // externalRefs (the poster's TMS connection id and a deep link naming
    // their broker and order number).
    //
    // The three remaining client callers are all admin surfaces:
    // /admin/page.tsx, /admin/loads/page.tsx, and admin-create-match-modal
    // (imported only by /admin/matches). Server-side readers use the Admin
    // SDK and bypass rules entirely.
    match /{path=**}/loads/{loadId} {
      allow read: if isSignedIn() && isAdmin();
    }

    // Matches collection
    // DEV-95: tighten to require the caller is a party to the match (load
    // owner, driver owner, or the driver themselves), or an admin. Match
    // *formation* happens server-side via /api/matches/accept (DEV-162) and
    // bypasses these rules entirely via the Admin SDK — these rules only
    // constrain direct client writes (e.g. rejecting an offer, cancelling).
    match /matches/{matchId} {
      // A match document carries both sides' negotiated terms: originalTerms,
      // counterTerms, and loadSnapshot.price. `if isSignedIn()` made every
      // carrier's pricing readable by anyone who could register an account.
      //
      // It was open because /dashboard/matches needed OTHER owners'
      // commitments to know which drivers were already booked, and read the
      // whole collection to find out. /api/commitments answers that question
      // with driver ids and date windows instead, so the collection no longer
      // has to be world-readable to make the board work.
      //
      // Every remaining client query filters on one of these four fields:
      // recipientOwnerId (incoming-matches, requests, use-pending-requests-count),
      // loadOwnerId (sent-requests, dashboard), driverOwnerId (dashboard),
      // driverId (driver-dashboard). isAdmin() covers the admin console,
      // which lists the collection unfiltered.
      //
      // `.data.get(field, default)` rather than `.data.field`, for the same
      // reason as isAdmin() above (DEV-199): a match predating
      // recipientOwnerId has the field absent, and reading a missing property
      // is an evaluation error rather than false.
      //
      // Measured, not assumed: swapping this one branch to direct access and
      // re-running the rules suite leaves all 85 tests GREEN, so this is a
      // readability and convention choice, not a behavioural fix. The reason
      // is that the Rules language absorbs an error in one `||` operand when
      // a later one is true — `false || error || isAdmin()` is still true for
      // an admin, and still a denial for everyone else. There is deliberately
      // no test asserting a difference between the two forms, because the
      // emulator says there isn't one.
      //
      // It stays in .get() form anyway: it matches the accessor the rest of
      // this file uses, it denies cleanly instead of surfacing a red
      // "Property is undefined" in the Rules Playground, and it does not rest
      // on error-absorption subtleties holding for a branch order someone
      // reorders later.
      allow read: if isSignedIn() && (
        resource.data.get('loadOwnerId', '') == request.auth.uid ||
        resource.data.get('driverOwnerId', '') == request.auth.uid ||
        resource.data.get('driverId', '') == request.auth.uid ||
        resource.data.get('recipientOwnerId', '') == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.loadOwnerId == request.auth.uid ||
        resource.data.driverOwnerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.loadOwnerId == request.auth.uid ||
        isSuperAdmin()
      );
    }

    // TLAs collection
    // Creation is server-only (/api/matches/accept) so the synchronous
    // compliance gate cannot be bypassed (DEV-162). DEV-95: lock updates
    // to TLA parties or admins — was over-permissive before.
    match /tlas/{tlaId} {
      // A TLA carries both parties' legal names, addresses, contact emails
      // and phones, the driver's CDL number and medical card expiry, the
      // pickup/delivery contacts, and each signature's IP address. This was
      // `if isSignedIn()`, which made every agreement in the marketplace
      // readable by anyone who could register an account.
      //
      // Every non-admin client query of this collection is already scoped
      // with or(lessor.ownerOperatorId == uid, lessee.ownerOperatorId == uid),
      // so party-scoping costs nothing. isAdmin() is required: the admin
      // console lists TLAs with an unfiltered collection read.
      allow read: if isSignedIn() && (
        resource.data.lessor.ownerOperatorId == request.auth.uid ||
        resource.data.lessee.ownerOperatorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if false;
      allow update: if isSignedIn() && (
        resource.data.lessor.ownerOperatorId == request.auth.uid ||
        resource.data.lessee.ownerOperatorId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    // Conversations collection
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && isParticipant(resource.data.participants);
      allow create: if isSignedIn() && isParticipant(request.resource.data.participants);
      allow update: if isSignedIn() && isParticipant(resource.data.participants);
      allow delete: if isSignedIn() && isSuperAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() && isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);
        allow create: if isSignedIn() && isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);
        allow update: if isSignedIn() && isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);
        allow delete: if isSignedIn() && isSuperAdmin();
      }
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Allow creating notifications for any user (needed for match acceptance/rejection notifications)
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
    }

    // Audit logs - users can read their own, admins can read all
    match /audit_logs/{logId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Admin audit logs - only admins can read
    match /admin_audit/{logId} {
      allow read: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() && isAdmin();
      allow update, delete: if false;
    }

    // Activation tokens for white-glove pre-activation onboarding (DEV-158).
    // One-time credentials — written and read only server-side via the Admin
    // SDK (which bypasses rules). Never accessible to clients.
    match /activation_tokens/{tokenId} {
      allow read, write: if false;
    }

    // Stripe payments (DEV-84). Written ONLY by the server (webhook + refund
    // routes via Admin SDK). Readable by admins so /admin/billing and
    // /admin/tlas can render the payment history; not exposed to regular
    // users — the TLA doc's matchFeePaid flag carries the user-facing state.
    match /payments/{paymentId} {
      allow read: if isSignedIn() && isAdmin();
      allow write: if false;
    }

    // TMS integration connections (DEV-155). Written and read ONLY by the
    // server via the Admin SDK. Closed to clients entirely — even the
    // non-secret fields (provider, external account id, granted
    // capabilities) describe a customer's back-office topology, and the
    // credentialRef names a secret-store entry. Admins inspect these through
    // a server route, not by reading Firestore directly.
    match /tms_connections/{connectionId} {
      allow read, write: if false;
    }

    // Raw inbound TMS webhook deliveries (DEV-155). Append-only server-side
    // log used for idempotency and replay; the document id is the provider's
    // event id. Payloads are provider data verbatim, so they never go to a
    // client.
    match /tms_events/{eventId} {
      allow read, write: if false;
    }
  }
}
